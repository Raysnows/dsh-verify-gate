{
  "name": "dsh-verify-gate",
  "version": "0.1.5",
  "description": "Completion gate for CodeBuddy (DSH) — when a turn changed code but nothing verified it, one reminder reaches the model before it can finish. AI 改完代码没验证就在收工处叫住它：改过代码却一次检查都没跑时，向模型下一步上下文注入一条提醒；确实不需要检查可申报豁免。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./lib/ledger.js": "./lib/ledger.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "icon.svg",
    "assets",
    "lib/",
    "locale/",
    "test/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "cordis",
    "harness",
    "verification",
    "gate",
    "testing",
    "test-runner",
    "devtools",
    "developer-tools",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raysnows/dsh-verify-gate.git"
  },
  "bugs": {
    "url": "https://github.com/Raysnows/dsh-verify-gate/issues"
  },
  "homepage": "https://github.com/Raysnows/dsh-verify-gate#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  }
}
